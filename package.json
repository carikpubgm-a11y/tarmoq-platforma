{
  "name": "tarmoq-platforma",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "description": "Kompyuter tarmoqlarini loyihalash va tarmoq xavfsizligini o'qitish — interaktiv ta'lim platformasi",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
