    "typecheck": "tsc --noEmit",
    "start": "node server.js",
    "serve": "npm run build && node server.js",
    "dars": "npm run build && node server.js",
    "build:cf": "vite build"
  },
  "dependencies": {
    "lucide-react": "^1.71.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-router-dom": "^7.18.5"
  },
  "devDependencies": {
    "@fontsource-variable/inter": "^5.3.0",
    "@fontsource-variable/jetbrains-mono": "^5.3.0",
    "@fontsource-variable/plus-jakarta-sans": "^5.3.0",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.3.0",
    "autoprefixer": "^10.6.2",
    "postcss": "^8.5.32",
    "tailwindcss": "^3.4.19",
    "typescript": "^7.0.2",
    "vite": "^8.3.7",
    "vite-plugin-singlefile": "^2.3.4",
    "wrangler": "^4.159.0"
  }
